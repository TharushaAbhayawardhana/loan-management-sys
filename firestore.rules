rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: each user can read their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Households collection: only authenticated members can read
    match /households/{householdId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Members can be added via invite code (update only)
      allow write: if request.auth != null && (
        request.auth.uid in resource.data.members
        || request.resource.data.members == resource.data.members
      );

      // Subcollections: loans
      match /loans/{loanId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.originalAmount is number
          && request.resource.data.originalAmount > 0
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // Subcollections: paymentLedger
      match /paymentLedger/{paymentId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members
          && request.resource.data.amountPaid is number
          && request.resource.data.amountPaid > 0
          && request.resource.data.recordedBy == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // Subcollections: cashTransactions
      match /cashTransactions/{transactionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.recordedBy == request.auth.uid;

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // Subcollections: systemSettings
      match /systemSettings/{settingId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
